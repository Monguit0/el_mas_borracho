{
  "name": "el-mas-borracho",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @borracho/server",
    "dev:client": "npm run dev -w @borracho/client",
    "build": "npm run build -w @borracho/client",
    "start": "npm run start -w @borracho/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.3",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
